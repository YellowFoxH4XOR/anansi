# Required: REST access for collector discovery and job history.
BRIGHTDATA_API_KEY=

# real writes through the Bright Data CLI; fake keeps heal writes offline.
ANANSI_ADAPTER=real
WITH_BRIGHTDATA_CLI=true
ANANSI_POLL_SECONDS=10

# Host ports for the production Lab and open, read-only console.
ANANSI_LAB_PORT=4600
ANANSI_CONSOLE_PORT=4700

# Optional prompt generation. The deterministic renderer is used when omitted.
GEMINI_API_KEY=
