FROM node:22-slim AS ui
WORKDIR /app/console-ui
COPY apps/console-ui/package.json apps/console-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/console-ui/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY tsconfig.json ./
COPY packages/core/ ./packages/core/
COPY packages/adapters/ ./packages/adapters/
COPY apps/console/ ./apps/console/
COPY --from=ui /app/console-ui/dist ./apps/console-ui/dist

RUN mkdir -p /data && chown node:node /data
USER node

ENV PORT=4700 ANANSI_DATA=/data
EXPOSE 4700
CMD ["./node_modules/.bin/tsx", "apps/console/server.ts"]
