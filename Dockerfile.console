# ANANSI console — JSON API over the store + the React SPA.
# Read-only: it never writes to the data volume, it just watches what the agent
# writes there (state.json is mtime-invalidated so the fleet stays live).

# ── stage 1 · build the React console ────────────────────────────────────────
FROM node:22-slim AS ui
WORKDIR /app/console-ui
COPY apps/console-ui/package.json apps/console-ui/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY apps/console-ui/ ./
RUN npm run build

# ── stage 2 · runtime ────────────────────────────────────────────────────────
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
# tsx is a runtime dependency here: every entrypoint runs TypeScript directly.
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund
COPY tsconfig.json ./
COPY packages/core/ ./packages/core/
COPY packages/adapters/ ./packages/adapters/
COPY apps/console/ ./apps/console/
COPY --from=ui /app/console-ui/dist ./apps/console-ui/dist

ENV PORT=4700 ANANSI_DATA=/data
EXPOSE 4700
CMD ["npx", "tsx", "apps/console/server.ts"]
